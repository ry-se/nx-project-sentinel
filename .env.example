# Copy to .env and fill in your values. Never commit .env (see .gitignore).

# LLM Configuration
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_PROD_MODEL=gpt-4o
# OPENAI_DEV_MODEL=gpt-4o-mini
# DEFAULT_LLM_MODEL=gpt-4o

# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-key-here

# Database
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# Authentication
# JWT_SECRET_KEY=change-this-to-a-random-string

# Backend — detection API (apps/backend, see specs/intel-import-and-detections.md)
# DETECTOR_PROVIDER=vlm-local   # vlm-local (default, Ollama) | vlm-api (hosted) | stub (tests/dev)
# DETECTOR_MODEL=               # default per provider if unset: vlm-local -> qwen2.5vl:3b
# DETECTOR_BASE_URL=            # default per provider if unset: vlm-local -> http://localhost:11434/v1
# DETECTOR_API_KEY=             # only needed for DETECTOR_PROVIDER=vlm-api
# DETECTOR_TILING_ENABLED=true  # splits captures into overlapping tiles before detection
#                                # for placement precision (default true) — set false to
#                                # fall back to the untiled single-shot path
# DETECTOR_REASONING_EFFORT=    # "low"|"medium"|"high" — ONLY for reasoning-capable models
#                                # (o-series, gpt-5.x); leave unset for non-reasoning models
#                                # (gpt-4o, qwen2.5vl) — reasoning models reject an explicit
#                                # temperature, so setting this also drops temperature=0.0
# CORS_ALLOWED_ORIGINS=http://localhost:4200   # comma-separated explicit origins, never "*"

# Frontend — detection client (apps/frontend, VITE_-prefixed vars only, see vite.config.mts
# envDir — Vite is configured to read this root .env, not apps/frontend/.env)
# VITE_GOOGLE_TILES_KEY=your-map-tiles-key-here   # Google Photorealistic 3D Tiles / Map Tiles API
# VITE_DETECT_API=http://localhost        # compose/nginx base URL, no trailing slash
# VITE_DETECT_API=http://localhost:8000   # local backend without nginx, no trailing slash
